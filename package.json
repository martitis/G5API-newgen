{
  "name": "g5api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "licenses": [
    {
      "type": "MIT",
      "url": "http://opensource.org/licenses/MIT"
    }
  ],
  "homepage": "https://github.com/martitis/G5API-newgen#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/martitis/G5API-newgen.git"
  },
  "author": {
    "name": "martitis",
    "url": "https://github.com/martitis"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "directories": {
    "docs": "./docs/",
    "bin": "./bin/",
    "routes": "./routes/",
    "config": "./config"
  },
  "scripts": {
    "build": "yarn clean && tsc",
    "lint": "eslint . --max-warnings=523",
    "format": "prettier --write",
    "clean": "node -e \"require('fs').rmSync('./dist',{recursive:true,force:true})\"",
    "start": "tsc-watch --project . --outDir ./dist --onSuccess \"nodemon ./dist/bin/www.js\"",
    "tsstart": "yarn build && nodemon ./dist/bin/www.js",
    "startprod": "pm2 start ./prodrun.json --name \"G5API\"",
    "restartprod": "pm2 restart G5API",
    "stopprod": "pm2 delete G5API",
    "doc": "tsc && jsdoc -c jsdoc.conf.json",
    "docclean": "node -e \"require('fs').rmSync('./docs',{recursive:true,force:true})\"",
    "migrate-create-dev": "cross-env MYSQL_FLAGS=-CONNECT_WITH_DB db-migrate --env development --config config/development.json db:create get5dev",
    "migrate-create-prod": "cross-env MYSQL_FLAGS=-CONNECT_WITH_DB db-migrate --env production --config config/production.json db:create get5",
    "migrate-create-test": "cross-env MYSQL_FLAGS=-CONNECT_WITH_DB db-migrate --env test --config config/test.json db:create get5test",
    "migrate-dev-downgrade": "db-migrate --env development --config config/development.json down:development",
    "migrate-dev-upgrade": "db-migrate --env development --config config/development.json up:development",
    "migrate-prod-downgrade": "db-migrate --env production --config config/production.json down:production",
    "migrate-prod-upgrade": "db-migrate --env production --config config/production.json up:production",
    "migrate-test-downgrade": "db-migrate --env test --config config/test.json down:test",
    "migrate-test-upgrade": "db-migrate --env test --config config/test.json up:test",
    "migrate-drop-dev": "cross-env MYSQL_FLAGS=-CONNECT_WITH_DB db-migrate --config config/development.json db:drop get5dev",
    "migrate-drop-prod": "cross-env MYSQL_FLAGS=-CONNECT_WITH_DB db-migrate --env production --config config/production.json db:drop get5",
    "migrate-drop-test": "cross-env MYSQL_FLAGS=-CONNECT_WITH_DB db-migrate --env test --config config/test.json db:drop get5test",
    "prod": "cross-env NODE_ENV=production yarn migrate-create-prod && yarn migrate-prod-upgrade",
    "test": "yarn build && yarn test:unit && yarn test:setup-user && yarn migrate-drop-test && yarn migrate-create-test && yarn migrate-test-upgrade && yarn test:user && yarn test:gameservers && yarn test:teams && yarn test:matches && yarn test:seasons && yarn test:vetoes && yarn test:mapstats && yarn test:playerstats && yarn test:vetosides && yarn test:maplists && yarn test:leaderboard && node scripts/test-admin.mjs reset",
    "test:gameservers": "yarn test:removeID && cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --detectOpenHandles --forceExit --config ./jest_config/jest.gameservers.config.cjs",
    "test:leaderboard": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --detectOpenHandles --forceExit --config ./jest_config/jest.leaderboard.config.cjs",
    "test:mapstats": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --detectOpenHandles --forceExit --config ./jest_config/jest.mapstats.config.cjs",
    "test:maplists": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --detectOpenHandles --forceExit --config ./jest_config/jest.maplist.config.cjs",
    "test:matches": "node scripts/test-admin.mjs admin && cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --detectOpenHandles --forceExit --config ./jest_config/jest.matches.config.cjs",
    "test:playerstats": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --detectOpenHandles --forceExit --config ./jest_config/jest.playerstats.config.cjs",
    "test:removeID": "node scripts/test-admin.mjs reset",
    "test:seasons": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --detectOpenHandles --forceExit --config ./jest_config/jest.seasons.config.cjs",
    "test:setup-user": "node scripts/test-admin.mjs set",
    "test:teams": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --detectOpenHandles --forceExit --config ./jest_config/jest.teams.config.cjs",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --forceExit --config ./jest_config/jest.unit.config.cjs",
    "test:user": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --detectOpenHandles --forceExit --config ./jest_config/jest.users.config.cjs",
    "test:vetoes": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --detectOpenHandles --forceExit --config ./jest_config/jest.vetoes.config.cjs",
    "test:vetosides": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testTimeout=10000 --detectOpenHandles --forceExit --config ./jest_config/jest.vetosides.config.cjs"
  },
  "dependencies": {
    "@node-steam/id": "^1.2.0",
    "aes-js": "^3.1.2",
    "bcrypt": "^5.1.1",
    "config": "^3.3.11",
    "connect-redis": "^7.1.1",
    "cookie-parser": "~1.4.6",
    "cors": "^2.8.5",
    "dathost-rcon-client": "^1.0.8",
    "db-migrate": "^0.11.13",
    "db-migrate-mysql": "^3.0.0",
    "debug": "~4.3.4",
    "express": "~4.21.2",
    "express-bearer-token": "^3.0.0",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.2",
    "helmet": "^7.1.0",
    "http-errors": "~2.0.0",
    "jszip": "^3.10.1",
    "morgan": "^1.10.1",
    "mysql2": "^3.14.0",
    "node-fetch": "^3.3.2",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0",
    "passport-steam": "^1.0.18",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pm2": "^5.3.1",
    "randomstring": "^1.3.0",
    "redis": "^4.6.13",
    "steamapi": "^3.0.8",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aes-js": "^3.1.1",
    "@types/bcrypt": "^5.0.2",
    "@types/config": "^3.3.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.18.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.2.5",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/passport-openidconnect": "^0.1.3",
    "@types/passport-steam": "^1.0.6",
    "@types/randomstring": "^1.3.0",
    "@types/steamapi": "^2.2.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^7.0.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "jest-ts-webcompat-resolver": "^1.0.0",
    "jsdoc": "^4.0.2",
    "nodemon": "^3.1.9",
    "passport-openidconnect": "^0.1.2",
    "prettier": "3.9.8",
    "supertest": "^6.3.3",
    "ts-jest": "^29.3.0",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.70.1"
  },
  "bugs": {
    "url": "https://github.com/martitis/G5API-newgen/issues"
  },
  "description": "Backend of a CS2 tournament panel that drives MatchZy: matches, live stats, teams, servers, tournaments and PUG queues."
}
